{
  "name": "@chapfoody/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domain types and constants shared by the Chapfoody API and every frontend surface",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@chapfoody/config": "workspace:*",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
