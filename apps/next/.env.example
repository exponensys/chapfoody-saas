# ─────────────────────────────────────────────────────────────────────────────
# Chapfoody platform (Next.js) — environment template
#
#   cp apps/next/.env.example apps/next/.env.local
#
# ⚠️ Only NEXT_PUBLIC_* values reach the browser. Everything here is public by
#    definition — never put a secret, a database URL or a private API key in this
#    file. Server-only secrets belong to apps/api (see apps/api/.env.example).
#
# SCOPE: read in M0. The storefront domain is consumed from M11 onwards and is
# declared now so the naming cannot drift.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Platform ─────────────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap entries and absolute links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Tenant storefront  (M11, requirement C) ──────────────────────────────────
# Root domain for client selling websites: <tenant>.chapfoody.com is rewritten by
# middleware.ts to /boutique/<tenant>. Keep it without a protocol or a port.
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN="chapfoody.com"

# ── Observability  (M14) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=""
