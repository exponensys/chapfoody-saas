# ─────────────────────────────────────────────────────────────────────────────
# Chapfoody API — environment template
#
#   cp apps/api/.env.example apps/api/.env.local
#
# `.env.local` is git-ignored and must never be committed.
#
# SCOPE OF THIS FILE
#   ✅ read today, in M0: NODE_ENV, PORT, DATABASE_URL, REDIS_URL
#   📝 declared now, implemented in M2 (Prisma) and M3 (auth): the variables below
#      marked "(M2)" / "(M3)". They are documented here so the contract is visible
#      from the start and nobody invents a different name later.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production. Anything else fails at boot, on purpose.
NODE_ENV=development
PORT=4000

# ── Database — Neon PostgreSQL  ──────────────────────────────────────────────
# TWO URLs are required and they are NOT interchangeable:
#
#   DATABASE_URL  → POOLED connection. Its host contains "-pooler".
#                   Used by the running API and worker. Serverless runtimes open a
#                   connection per invocation, so the pooler is mandatory; keep
#                   ?pgbouncer=true&connection_limit=1 in the query string.
#
#   DIRECT_URL    → DIRECT connection. No "-pooler" in the host.
#                   Used ONLY by Prisma migrate / db push / introspect, which need
#                   a session-level connection (advisory locks, DDL). Running a
#                   migration through the pooler hangs or fails.
#
# Where to find them: Neon console → Project → Connect → enable "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/chapfoody?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/chapfoody?sslmode=require"

# Local alternative — no Neon account needed, requires Docker:
#   pnpm db:up
# DATABASE_URL="postgresql://chapfoody:chapfoody@localhost:5432/chapfoody?schema=public"
# DIRECT_URL="postgresql://chapfoody:chapfoody@localhost:5432/chapfoody?schema=public"

# ── Redis — cache, rate limiting, BullMQ queues  ─────────────────────────────
# Defaults to redis://127.0.0.1:6379 when unset. `pnpm db:up` provides one locally.
REDIS_URL="redis://127.0.0.1:6379"

# ── CORS  (M0: documented, wired in M1) ──────────────────────────────────────
CORS_ORIGINS="http://localhost:3000"

# ── Auth  (M3) ───────────────────────────────────────────────────────────────
# Generate each secret with:  openssl rand -base64 48
# Access tokens are short-lived; refresh tokens rotate and are stored httpOnly.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Google OAuth (requirement A.V / A.VI). Create the credentials in Google Cloud
# Console → APIs & Services → Credentials, and add the redirect URI below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/v1/auth/google/callback"

# TOTP MFA (requirement A.V). Shown as the issuer name in authenticator apps.
MFA_ISSUER="Chapfoody"

# ── Seed  (M2) ───────────────────────────────────────────────────────────────
# The seed refuses to run when NODE_ENV=production unless this is explicitly true.
# SEED_ALLOW_PRODUCTION=false
