# ─────────────────────────────────────────────────────────────────────────────
# Chapfoody API — environment template
#
#   cp apps/api/.env.example apps/api/.env.local
#
# `.env.local` is git-ignored and must never be committed. It is loaded natively by
# Node (`node --env-file-if-exists=.env.local`), so dotenv is not a dependency.
#
# SCOPE
#   ✅ read today (M3): NODE_ENV, PORT, DATABASE_URL, REDIS_URL, LOG_LEVEL,
#      SWAGGER_ENABLED, CORS_ORIGINS, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
#      ACCESS_TOKEN_TTL, REFRESH_TOKEN_TTL, COOKIE_*, MAX_FAILED_LOGIN_ATTEMPTS,
#      LOCKOUT_DURATION, GOOGLE_*, MFA_ISSUER, MFA_ENCRYPTION_KEY
#   📝 declared here but not yet implemented: nothing — every variable below is read.
#      (The M1 note said the auth block was "declared now, implemented in M3"; M3 has
#      landed, so this template and the code agree again.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production. Anything else fails at boot, on purpose.
NODE_ENV=development
PORT=4000

# fatal | error | warn | info | debug | trace | silent
# Default: debug in development, info in production, silent in tests.
# LOG_LEVEL=debug

# Serves the OpenAPI documentation at /docs. Default: enabled everywhere except
# production, where exposure is opt-in.
# SWAGGER_ENABLED=true

# Comma-separated list of allowed browser origins (the Next.js app).
CORS_ORIGINS="http://localhost:3000"

# ── Database — Neon PostgreSQL ───────────────────────────────────────────────
# TWO URLs, for two different jobs. They are NOT interchangeable, and since Prisma 7
# they are configured in two different places:
#
#   DATABASE_URL  → POOLED (its host contains "-pooler").
#                   Consumed at RUNTIME by `PrismaService`, which hands it to the pg
#                   driver adapter. Serverless runtimes open a connection per
#                   invocation, so the pooler is mandatory; keep
#                   ?pgbouncer=true&connection_limit=1 in the query string.
#
#   DIRECT_URL    → DIRECT (no "-pooler").
#                   Consumed by the Prisma **CLI** through `prisma.config.ts`, i.e.
#                   `prisma migrate`, `db pull` and `studio`. Migrations take
#                   session-level locks and run DDL, neither of which survives
#                   transaction-mode pooling — through the pooler they hang or fail.
#
# Where to find them: Neon console → Project → Connect → enable "Pooled connection".
DATABASE_URL="postgresql://chapfoody_app:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/chapfoody?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://OWNER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/chapfoody?sslmode=require"

# The role matters as much as the URL in DATABASE_URL: PostgreSQL exempts superusers and
# BYPASSRLS roles from row-level security, so connecting as the database owner silently
# disables every tenant isolation policy — and the isolation suite would pass without
# proving anything. See prisma/sql/app-role.sql, which creates the role.

# Local alternative — no Neon account needed. Requires PostgreSQL: either `pnpm db:up`
# (Docker) or a locally installed server. Create the app role once, then migrate and seed:
#   psql "$DIRECT_URL" -v app_role_password="'a-password'" -f prisma/sql/app-role.sql
#   pnpm --filter @chapfoody/api exec prisma migrate deploy
#   pnpm --filter @chapfoody/api exec prisma db seed
#
# A "#" in a password must be percent-encoded as %23: unencoded, everything after it is
# parsed as a URL fragment and the password silently truncates.
# DATABASE_URL="postgresql://chapfoody_app:a-password@localhost:5432/chapfoody_db"
# DIRECT_URL="postgresql://postgres:owner-password@localhost:5432/chapfoody_db"

# ── Redis — cache, rate limiting, BullMQ queues ─────────────────────────────
# OPTIONAL for the API: with it unset the API boots normally and /health/queue
# reports "disabled". It is REQUIRED for the worker entrypoint, which exits non-zero
# without it (there would be nothing to consume).
REDIS_URL="redis://127.0.0.1:6379"

# ── Integration tests (opt-in) ──────────────────────────────────────────────
# The database and queue integration suites are skipped unless these are set. They
# are prefixed INTEGRATION_ so the unit/e2e runs stay deterministic and can never
# accidentally touch a real database.
#
# INTEGRATION_DATABASE_URL MUST be the application role, not the owner: the tenant
# isolation suite inspects the role it was given and refuses to run as a superuser,
# because PostgreSQL would bypass every policy and the tests would pass without proving
# anything.
#
#   INTEGRATION_DATABASE_URL="postgresql://chapfoody_app:a-password@localhost:5432/chapfoody_db" \
#   INTEGRATION_REDIS_URL="redis://localhost:6379" \
#     pnpm --filter @chapfoody/api test:integration

# ── Auth  (M3) ───────────────────────────────────────────────────────────────
# Generate each secret with:  openssl rand -base64 48
# Access tokens are short-lived; refresh tokens rotate and are stored httpOnly.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Google OAuth (requirement A.V / A.VI). Create the credentials in Google Cloud
# Console → APIs & Services → Credentials, and add the redirect URI below.
#
# The redirect URI must be registered EXACTLY as it appears here, character for character:
# Google compares it literally, and a mismatch fails with `redirect_uri_mismatch` after
# the user has already consented. Register one per environment (dev, staging, production).
#
# Testing vs production on the consent screen: `openid`, `email` and `profile` are
# NON-sensitive scopes, so there is no Google review to wait for. While the OAuth consent
# screen is still in "Testing", add every account that will sign in as a Test user, or
# Google refuses with `access_blocked` and the app never sees a callback.
#
# Leave all three unset to disable Google sign-in. `/v1/auth/google` then answers `503`
# with a message that says so, rather than failing in a way that looks like a bug.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/v1/auth/google/callback"

# TOTP MFA (requirement A.V). Shown as the issuer name in authenticator apps.
MFA_ISSUER="Chapfoody"

# Encrypts the enrolled TOTP secrets at rest. REQUIRED in production, where `loadEnv`
# refuses to start without it.
#
# A TOTP secret cannot be hashed like a password: verifying a code means recomputing it, so
# the secret has to be readable. It is therefore encrypted under THIS key, held in the
# environment rather than the database, so that a database dump alone is not enough to
# generate anybody's codes. Losing the key means every enrolled user must re-enrol.
#
# Changing it is a migration, not a config change: existing rows can no longer be opened.
# Generate with:  openssl rand -base64 48
MFA_ENCRYPTION_KEY=""

# ── Seed  (M2) ───────────────────────────────────────────────────────────────
# The seed refuses to run when NODE_ENV=production unless this is explicitly true.
# SEED_ALLOW_PRODUCTION=false
