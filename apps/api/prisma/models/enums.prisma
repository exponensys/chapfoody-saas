// Shared enumerations.
//
// Kept in one file because several domains use them (a currency appears on
// businesses, plans, payments and orders) and duplicating an enum per domain would
// let the values drift.

/// Interface language. French is the product default; English is the second locale.
enum Locale {
  FR
  EN

  @@map("locale")
}

// ── Identity ─────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Asked for deletion; retained only as long as the law requires.
  DELETED

  @@map("user_status")
}

/// External identity providers. Google is required by A.V / A.VI; the enum is here
/// so that adding Apple or Facebook later is not a schema surprise.
enum AuthProvider {
  GOOGLE

  @@map("auth_provider")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  MFA_RESET
  INVITATION

  @@map("verification_purpose")
}

/// The role vocabulary, mirrored by @chapfoody/types USER_ROLES.
/// Keep the two in step: a seed test asserts they match.
enum RoleKey {
  /// Platform staff. The only role that may reach /admin (requirement D).
  SUPER_ADMIN
  /// Owner of a client business.
  OWNER
  MANAGER
  CASHIER
  VENDOR
  ACCOUNTANT

  @@map("role_key")
}

enum BusinessStatus {
  /// Signed up, still completing the onboarding wizard (M6).
  ONBOARDING
  ACTIVE
  /// Suspended by the super-admin, or for non-payment.
  SUSPENDED
  CLOSED

  @@map("business_status")
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("member_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

/// Who caused an audited action. `SYSTEM` covers jobs and integrations, `ADMIN`
/// covers super-admin impersonation (requirement D).
enum ActorType {
  USER
  SYSTEM
  ADMIN

  @@map("actor_type")
}

// ── Subscription and premium access ──────────────────────────────────────────

enum BillingPeriod {
  MONTHLY
  YEARLY

  @@map("billing_period")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  /// Payment failed; access continues during the grace period.
  PAST_DUE
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

/// A feature is either on/off or metered. Requirement B.13 gates features; quotas
/// additionally cap usage (SMS sent, storefront pages).
enum FeatureKind {
  FLAG
  QUOTA

  @@map("feature_kind")
}

/// Where a business's access to a feature came from, kept for support and billing.
enum EntitlementSource {
  PLAN
  ADDON
  OVERRIDE
  TRIAL

  @@map("entitlement_source")
}

enum PaymentProvider {
  STRIPE
  CINETPAY
  PAYSTACK
  FLUTTERWAVE
  /// Bank transfer or cash recorded by an administrator.
  MANUAL

  @@map("payment_provider")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID

  @@map("invoice_status")
}

// ── Catalog, inventory and purchasing ────────────────────────────────────────

/// How a product is counted and sold. Drives whether quantities may be fractional:
/// grams and litres may, pieces may not.
enum ProductUnit {
  PIECE
  KILOGRAM
  GRAM
  LITRE
  MILLILITRE
  PORTION
  BOX
  PACK

  @@map("product_unit")
}

/// The sales channel a price list applies to. A restaurant sells the same dish at
/// different prices on site, for takeaway and through a delivery platform.
enum PriceChannel {
  DINE_IN
  TAKEAWAY
  DELIVERY
  ONLINE
  B2B

  @@map("price_channel")
}

/// Whether a product contains an allergen or merely risks traces of it. Legally
/// distinct, and confusing them is a health matter, so they are separate values.
enum AllergenPresence {
  CONTAINS
  MAY_CONTAIN

  @@map("allergen_presence")
}

/// Why stock moved. Kept apart from "how much" so that a stock report can separate a
/// sale from a delivery, a loss, a stock count correction or a transfer.
enum StockMovementReason {
  PURCHASE
  SALE
  RETURN
  WASTE
  ADJUSTMENT
  STOCK_COUNT
  TRANSFER

  @@map("stock_movement_reason")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  /// Partially delivered: the supplier sent less than ordered.
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED

  @@map("purchase_order_status")
}

/// A stock-take is open while it is being counted, then closed once its differences have
/// been applied as movements.
enum StockCountStatus {
  OPEN
  CLOSED
  CANCELED

  @@map("stock_count_status")
}

// ── Sales, front of house, till and tax ──────────────────────────────────────

/// The life of an order, from the moment it is taken to the moment it is settled.
/// One status set for every channel: a delivery and a dine-in order differ in what they
/// need, not in how far along they are, and two parallel sets would drift apart.
enum OrderStatus {
  /// Taken but not yet sent to the kitchen — a POS ticket still being built.
  OPEN
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELED

  @@map("order_status")
}

/// How the order reached the business. Distinct from OrderType, which the business defines:
/// this is where it came from, that is what it needs (a table, a courier, nothing).
enum OrderChannel {
  POS
  STOREFRONT
  PHONE
  MARKETPLACE

  @@map("order_channel")
}

/// Kitchen state of a single line. Tracked per line rather than per order because a
/// starter is served long before the main course is plated.
enum OrderLineStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELED

  @@map("order_line_status")
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLEANING
  /// Broken, or deliberately not in use.
  OUT_OF_SERVICE

  @@map("table_status")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELED
  /// The party never arrived. Kept separate from CANCELED: one is the customer's doing,
  /// the other is not, and a no-show report is how a restaurant decides on a deposit policy.
  NO_SHOW

  @@map("reservation_status")
}

/// How a customer settles an order — the tender they hand over.
///
/// NOT called `PaymentMethod`, even though that is the natural name: the billing domain
/// already has a `PaymentMethod` MODEL, which is a stored card the PLATFORM charges a
/// business with. The two are different concepts that happen to share a name, and the
/// collision is a compile error rather than a subtle bug only because Prisma caught it.
/// "Tender" is also the more precise word for this side: the money the customer hands over.
enum TenderMethod {
  CASH
  CARD
  MOBILE_MONEY
  TRANSFER
  MEAL_VOUCHER
  LOYALTY_POINTS
  GIFT_CARD

  @@map("tender_method")
}

enum TenderStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED

  @@map("tender_status")
}

/// Why the drawer moved. Split from the amount so a till report can separate a sale from
/// a float, a withdrawal, a tip or a mistake.
enum CashMovementReason {
  OPENING_FLOAT
  CASH_SALE
  WITHDRAWAL
  DEPOSIT
  EXPENSE
  TIP
  REFUND
  ADJUSTMENT

  @@map("cash_movement_reason")
}

enum PosSessionStatus {
  OPEN
  CLOSED

  @@map("pos_session_status")
}

enum VatDeclarationStatus {
  DRAFT
  FILED
  PAID

  @@map("vat_declaration_status")
}

// ── Accounting ───────────────────────────────────────────────────────────────

/// The five classes of a chart of accounts. Every account belongs to exactly one, and it decides
/// which side of the balance sheet or the income statement the account lands on.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_type")
}

/// Which journal an entry belongs to. Accounting is kept in separate books because they are read
/// separately: the cash journal is reconciled against the drawer, the sales journal against orders.
enum JournalCode {
  SALES
  PURCHASES
  CASH
  BANK
  PAYROLL
  STOCK
  VAT
  GENERAL

  @@map("journal_code")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  /// An entry reversed by a compensating entry. Kept visible: accounting history is not edited,
  /// it is corrected in the open.
  REVERSED

  @@map("journal_entry_status")
}

enum DocumentType {
  SALES_INVOICE
  CREDIT_NOTE
  PURCHASE_INVOICE
  RECEIPT
  DELIVERY_NOTE
  OTHER

  @@map("document_type")
}

enum DocumentStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID

  @@map("document_status")
}

/// What the accountant asked for. FEC is the French legal exchange format
/// (fichier des écritures comptables) — worth naming explicitly because "CSV" is not accepted by an
/// auditor in its place.
enum ExportFormat {
  CSV
  EXCEL
  PDF
  FEC

  @@map("export_format")
}

enum ExportStatus {
  PENDING
  GENERATED
  FAILED

  @@map("export_status")
}

/// A periodic snapshot's state. A provisional balance sheet is a real thing in accounting: it is
/// produced before the period is closed, and it must be distinguishable from the final one.
enum SnapshotBasis {
  PROVISIONAL
  FINAL

  @@map("snapshot_basis")
}

// ── Vendors ──────────────────────────────────────────────────────────────────

/// What a commission rule applies to. A business-wide rate is an ORDER rule; a rule that pays more
/// on high-margin dishes is a PRODUCT rule.
enum CommissionScope {
  ORDER
  PRODUCT
  CATEGORY

  @@map("commission_scope")
}

// ── HR and payroll ───────────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  /// Still employed, not currently working: sick leave, parental leave, sabbatical.
  ON_LEAVE
  SUSPENDED
  TERMINATED

  @@map("employee_status")
}

/// The nature of the employment relationship, which decides what payroll owes and what the law
/// requires of it. Kept as an enum because these are legal categories, not a business's own labels.
enum ContractType {
  PERMANENT
  FIXED_TERM
  TEMPORARY
  INTERNSHIP
  APPRENTICESHIP
  FREELANCE

  @@map("contract_type")
}

enum ShiftStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  /// The employee did not turn up. Distinct from CANCELED, which is the business's doing —
  /// the two are treated very differently by a manager, and by the law.
  ABSENT
  CANCELED

  @@map("shift_status")
}

/// Where a clock-in came from. Matters for trust: a POS terminal clock-in is harder to fake than a
/// manual entry typed the next morning at the desk.
enum TimeEntrySource {
  MANUAL
  POS
  MOBILE
  IMPORT

  @@map("time_entry_source")
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELED

  @@map("payroll_status")
}

// ── Delivery ─────────────────────────────────────────────────────────────────

enum VehicleType {
  ON_FOOT
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
  OTHER

  @@map("vehicle_type")
}

/// The life of a delivery, which is shorter than the life of the order it carries: an order is
/// COMPLETED once it is paid for, a delivery is DELIVERED once it is in the customer's hands.
enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  /// The customer was not reachable, the address was wrong, the goods were refused.
  FAILED
  CANCELED

  @@map("delivery_status")
}

/// What happened, for the timeline. Includes NOTE because the things that go wrong — a locked gate, a
/// customer who answers on the third call — are exactly what a dispute turns on, and they are not
/// status changes.
enum DeliveryEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELED
  NOTE

  @@map("delivery_event_type")
}

/// What a driver is being paid for. Signed amounts, so a settlement is a sum rather than a
/// convention that someone will get backwards once.
enum EarningType {
  /// The fee for making a delivery.
  DELIVERY
  /// A tip the customer gave the driver.
  TIP
  BONUS
  /// A correction, positive or negative — the reason is in the note.
  ADJUSTMENT
  DEDUCTION

  @@map("earning_type")
}

enum EarningStatus {
  PENDING
  APPROVED
  PAID

  @@map("earning_status")
}

// ── Affiliate ────────────────────────────────────────────────────────────────

enum AffiliateStatus {
  /// Applied, not yet approved. Deliberately separate from ACTIVE: an affiliate programme that lets
  /// anyone earn before anyone has looked at them is a programme that pays for fraud.
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED

  @@map("affiliate_status")
}

/// What was referred. A SIGNUP earns nothing by itself; it is what the signup later does that does.
enum ReferralKind {
  SIGNUP
  ORDER
  SUBSCRIPTION

  @@map("referral_kind")
}

enum ReferralStatus {
  /// Attributed but not yet earned — a new customer inside the refund window, for instance.
  PENDING
  CONFIRMED
  /// Rejected on review: self-referral, a duplicate, or a refund.
  REJECTED

  @@map("referral_status")
}

enum CommissionType {
  /// The one-off commission on a referred sale.
  REFERRAL
  /// A share of a recurring subscription, for as long as the referral holds.
  RECURRING
  BONUS
  /// A correction, positive or negative — the reason goes in the note.
  ADJUSTMENT

  @@map("commission_type")
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  /// Undone: the referral was rejected or refunded after the commission was recorded.
  REVERSED

  @@map("commission_status")
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
  FAILED

  @@map("payout_status")
}

enum PayoutMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  PAYPAL
  CASH

  @@map("payout_method")
}

/// What a referral link points at. The affiliate chooses, because a link to one product converts
/// differently from a link to the homepage — and the difference is the affiliate's business.
enum ReferralTarget {
  STOREFRONT
  PRODUCT
  CATEGORY
  SIGNUP
  CUSTOM

  @@map("referral_target")
}

// ── Customers ────────────────────────────────────────────────────────────────

/// A LEAD is a name and a phone number that has never bought anything — captured at the counter or
/// on the storefront. Keeping it apart from ACTIVE is what makes "how many of the people we captured
/// actually converted?" an answerable question instead of a guess.
enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("customer_status")
}

/// Where the customer came from. REFERRAL closes the loop with the affiliate domain: a referral that
/// converts produces a customer whose source says so, which is how a partner's numbers get checked.
enum CustomerSource {
  POS
  STOREFRONT
  REFERRAL
  IMPORT
  MANUAL
  MARKETPLACE

  @@map("customer_source")
}

enum ConsentChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
  PHONE

  @@map("consent_channel")
}

/// What the consent is FOR. Marketing consent does not imply transactional consent, and treating one
/// as the other is both a compliance failure and an operational one — an order confirmation is not a
/// marketing message and must not be blocked by a marketing opt-out.
enum ConsentPurpose {
  MARKETING
  TRANSACTIONAL
  PROFILING
  THIRD_PARTY

  @@map("consent_purpose")
}

enum ConsentStatus {
  GRANTED
  DENIED
  WITHDRAWN

  @@map("consent_status")
}

/// How consent was captured. VERBAL is here because a phone order is a real way to obtain consent and
/// a real way to lose an argument about whether it was obtained.
enum ConsentSource {
  WEB
  POS
  IMPORT
  API
  VERBAL

  @@map("consent_source")
}
