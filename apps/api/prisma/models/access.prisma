// Access control records and the audit trail — both business-scoped, both under RLS.

/// A pending invitation to join a business.
///
/// The token is stored hashed, and the status is explicit rather than derived, so an
/// expired or revoked invitation can be reasoned about without guessing.
model Invitation {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  email  String           @db.VarChar(320)
  role   RoleKey
  status InvitationStatus @default(PENDING)

  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  invitedById  String    @map("invited_by_id")
  acceptedById String?   @map("accepted_by_id")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  revokedAt    DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy  User     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?    @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([email])
  @@index([expiresAt])
  @@map("invitation")
}

/// Append-only record of every write (requirement G, "security first").
model AuditLog {
  id String @id @default(cuid())

  /// Nullable: platform-level actions (super-admin, billing jobs) belong to no tenant.
  businessId String? @map("business_id")

  actorType   ActorType
  actorUserId String?   @map("actor_user_id")

  /// Dotted, stable and greppable: 'order.created', 'plan.changed', 'auth.login'.
  action     String  @db.VarChar(96)
  entityType String  @map("entity_type") @db.VarChar(64)
  entityId   String? @map("entity_id")

  /// Correlation id of the request that caused this, so an audit entry can be matched
  /// to its log lines and to a support ticket.
  requestId String? @map("request_id") @db.VarChar(128)
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.Text

  /// Digest of the before/after payload rather than the payload itself: it keeps the
  /// log small and avoids copying personal data into an append-only table that is hard
  /// to erase (GDPR).
  diffHash String? @map("diff_hash") @db.VarChar(64)

  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  business  Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}
