// Stock — what a business has, where, and every movement that changed it.

/// A place stock is held: the shop floor, a storeroom, a van.
///
/// Separate locations rather than a single count, because "we have 12 bottles" is not an
/// answer a kitchen or a van can act on — where the twelve are is the useful part.
model StockLocation {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  name String  @db.VarChar(160)
  /// Optional short code for labels and imports.
  code String? @db.VarChar(32)

  addressLine String? @map("address_line") @db.VarChar(200)
  city        String? @db.VarChar(120)

  /// The location used when none is chosen. At most one per business — enforced by a
  /// partial unique index in the migration, since a Prisma boolean cannot be "unique when
  /// true".
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items          StockItem[]
  movements      StockMovement[]
  counts         StockCount[]
  purchaseOrders PurchaseOrder[]

  // A location can seat guests, be collected from, and take orders.
  tables       Table[]
  pickupPoints PickupPoint[]
  orders       Order[]

  // And it has a till, with one session open at a time.
  posSessions PosSession[]

  @@unique([businessId, name])
  @@index([businessId, isActive, name])
  @@map("stock_location")
}

/// The quantity of one item at one location — the current state, not the history.
///
/// ── Why the target is polymorphic ────────────────────────────────────────────
/// Stock is held for a product (a bottle of water) or for a raw ingredient (a sack of
/// rice), and those are different tables. Rather than a nullable pair with no referential
/// integrity, the migration adds a CHECK that exactly one target is set, plus partial
/// unique indexes so the same item cannot be stocked twice at the same location — the same
/// technique as `price_list_item`, and for the same reason: PostgreSQL treats NULLs as
/// distinct, so a plain compound unique would not constrain the NULL half.
model StockItem {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  locationId String @map("location_id")

  productId    String? @map("product_id")
  variantId    String? @map("variant_id")
  ingredientId String? @map("ingredient_id")

  /// Quantities carry three decimals: grams, millilitres and halves are all real.
  quantity Decimal @default(0) @db.Decimal(14, 3)

  /// At or below this, the item is "to reorder".
  reorderPoint    Decimal? @map("reorder_point") @db.Decimal(14, 3)
  /// How much to order when it is reached.
  reorderQuantity Decimal? @map("reorder_quantity") @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location   StockLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredient Ingredient?     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([businessId, locationId])
  @@index([productId])
  @@index([ingredientId])
  @@map("stock_item")
}

/// Every change to a quantity, as a ledger.
///
/// APPEND-ONLY. The integration suite asserts that neither UPDATE nor DELETE is possible
/// through the application role: a stock history that can be rewritten cannot be used to
/// explain a discrepancy, which is the only reason to keep it.
///
/// `quantityAfter` is stored even though it is derivable, because the derived value is only
/// correct if no movement was ever lost — and the whole point of a ledger is to be able to
/// tell when that assumption breaks.
model StockMovement {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  locationId String @map("location_id")

  productId    String? @map("product_id")
  variantId    String? @map("variant_id")
  ingredientId String? @map("ingredient_id")

  reason StockMovementReason

  /// Signed: negative for a sale, a loss or a waste; positive for a delivery or a return.
  quantityDelta Decimal  @map("quantity_delta") @db.Decimal(14, 3)
  quantityAfter Decimal? @map("quantity_after") @db.Decimal(14, 3)
  /// Cost of one unit at the time, so the ledger can be valued later without guessing.
  unitCost      Decimal? @map("unit_cost") @db.Decimal(14, 2)

  /// What caused it: an order id, a purchase order id, a stock count id.
  referenceType String? @map("reference_type") @db.VarChar(48)
  referenceId   String? @map("reference_id")

  note        String? @db.Text
  actorUserId String? @map("actor_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location  StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  actorUser User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  // Cascade on purpose: a movement is a record of the item, and if the item is deleted the
  // movement has nothing left to describe. Order-level history is kept by the sales domain,
  // which will hold its own copy.
  product    Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredient Ingredient?     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, productId, createdAt])
  @@index([businessId, ingredientId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movement")
}

/// A stock-take: counting what is actually there, against what the system believes.
model StockCount {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  locationId String @map("location_id")

  /// Human reference for the printed sheet ("Inventaire mensuel").
  reference String? @db.VarChar(120)

  status StockCountStatus @default(OPEN)

  startedAt DateTime  @map("started_at")
  /// Set when the count is closed; the moment the differences were applied as movements.
  closedAt  DateTime? @map("closed_at")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines    StockCountLine[]

  @@index([businessId, status, startedAt])
  @@map("stock_count")
}

/// One counted line: what the system expected, and what was found.
///
/// Both numbers are stored rather than just the difference: an auditor needs to see the
/// two figures the difference was computed from, and a rounding change must not silently
/// rewrite history.
model StockCountLine {
  id           String @id @default(cuid())
  businessId   String @map("business_id")
  stockCountId String @map("stock_count_id")

  productId    String? @map("product_id")
  variantId    String? @map("variant_id")
  ingredientId String? @map("ingredient_id")

  expectedQuantity Decimal @map("expected_quantity") @db.Decimal(14, 3)
  countedQuantity  Decimal @map("counted_quantity") @db.Decimal(14, 3)

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockCount StockCount  @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([stockCountId])
  @@index([businessId])
  @@map("stock_count_line")
}
