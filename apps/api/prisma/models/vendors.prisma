// Vendors — the people who sell on the business's behalf, and what they are owed.
//
// The feature registry has been gating `vendors.management` and `vendors.commissions` since the
// subscription increment, with quotas of 5 or 50 depending on the plan. These are the tables those
// features were gating.
//
// ── A vendor is not necessarily an employee, and not necessarily a user ───────
// A business may have a VENDEUR on its staff (a BusinessMember), an external agent paid on
// commission, or a partner who brings in orders. So `userId` is nullable: the vendor record must
// stand on its own, and linking it to an account is an upgrade rather than a prerequisite.
//
// ── Commission is COMPUTED AND STORED, never recomputed ──────────────────────
// The rule that produced a commission is kept on the assignment, alongside the amount. Rules change:
// what someone was owed for a sale in March must not move when the rate is renegotiated in April —
// the same reason an order line copies its price.

/// A person who sells on the business's behalf.
model Vendor {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  /// Set when the vendor also signs in. Nullable: an external agent has no account, and requiring
  /// one would mean creating credentials for someone who will never use them.
  userId String? @map("user_id")

  /// Short reference used on reports and in conversation: "V-01". Unique per tenant only.
  code String @db.VarChar(32)

  firstName String  @map("first_name") @db.VarChar(120)
  lastName  String  @map("last_name") @db.VarChar(120)
  email     String? @db.VarChar(320)
  phone     String? @db.VarChar(32)

  /// The default rate when no rule matches. Nullable, because a vendor may be paid a fixed amount
  /// per sale instead — carried by a CommissionRule.
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)

  /// Internal (staff) or external (agent). Changes nothing about the maths and a great deal about
  /// payroll, so it is recorded.
  isInternal Boolean @default(true) @map("is_internal")

  isActive  Boolean   @default(true) @map("is_active")
  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  notes     String?   @db.Text

  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user      User?    @relation("VendorUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("VendorAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  commissionRules VendorCommissionRule[]
  assignments     VendorAssignment[]
  targets         VendorTarget[]

  @@unique([businessId, code])
  @@index([businessId, isActive])
  @@index([userId])
  @@map("vendor")
}

/// How a vendor's commission is computed, when it is not simply their default rate.
///
/// Scope decides what the rule applies TO (the whole order, one product, a category), and the
/// optional revenue bounds make it a tier. Rules are ordered by `priority` and the first match wins,
/// which is why priority is stored rather than derived: precedence is a decision someone makes, not
/// something the database should infer.
model VendorCommissionRule {
  id         String  @id @default(cuid())
  businessId String  @map("business_id")
  /// Null applies the rule to every vendor — the usual case for a business-wide rate.
  vendorId   String? @map("vendor_id")

  name  String          @db.VarChar(160)
  scope CommissionScope @default(ORDER)

  /// Percentage of the base. Exactly one of rate / fixedAmount is set, enforced by a CHECK: a rule
  /// that said both would leave the actual commission to whoever read it last.
  rate        Decimal? @db.Decimal(5, 2)
  fixedAmount Decimal? @map("fixed_amount") @db.Decimal(14, 2)

  /// Tier bounds on the order's revenue. Null means unbounded on that side.
  minRevenue Decimal? @map("min_revenue") @db.Decimal(14, 2)
  maxRevenue Decimal? @map("max_revenue") @db.Decimal(14, 2)

  /// Lower runs first.
  priority Int @default(0)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendor   Vendor?  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  assignments VendorAssignment[]

  @@index([businessId, isActive, priority])
  @@index([vendorId])
  @@map("vendor_commission_rule")
}

/// Records that a vendor is credited with an order, and what that earned them.
///
/// One per order: a sale has one seller. Splitting a sale between two vendors is a conscious change
/// to this key, not something that should happen silently.
model VendorAssignment {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  vendorId   String @map("vendor_id")
  orderId    String @unique @map("order_id")

  /// What the commission was computed on — the order's subtotal, excluding tax and tip, since
  /// neither belongs to the seller.
  commissionBase Decimal @map("commission_base") @db.Decimal(14, 2)

  /// The rate that applied, copied from the rule. Null when the commission was a fixed amount.
  commissionRate   Decimal? @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal  @map("commission_amount") @db.Decimal(14, 2)

  /// Which rule produced it, so a disputed commission can be traced to a decision rather than
  /// re-derived from rules that have since changed.
  commissionRuleId String? @map("commission_rule_id")

  assignedAt DateTime @default(now()) @map("assigned_at")
  note       String?  @db.Text

  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendor         Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  commissionRule VendorCommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)

  @@index([businessId, assignedAt])
  @@index([vendorId, assignedAt])
  @@map("vendor_assignment")
}

/// A sales target for one vendor over one period, and what they actually did.
///
/// `achievedAmount` is a stored total, not a live sum, for the same reason a balance sheet is a
/// snapshot: a target is assessed at a moment, and a figure recomputed afterwards from orders that
/// were later refunded would silently move the goalposts on a bonus.
model VendorTarget {
  id         String @id @default(cuid())
  businessId String @map("business_id")
  vendorId   String @map("vendor_id")

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  targetAmount   Decimal @map("target_amount") @db.Decimal(14, 2)
  achievedAmount Decimal @default(0) @map("achieved_amount") @db.Decimal(14, 2)

  /// What meeting the target earns them, when the incentive is a lump sum.
  bonusAmount Decimal? @map("bonus_amount") @db.Decimal(14, 2)
  /// The rate applied to everything above the target, when the incentive is a higher rate instead.
  bonusRate   Decimal? @map("bonus_rate") @db.Decimal(5, 2)

  currency String  @default("EUR") @db.Char(3)
  note     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// One target per vendor per period.
  @@unique([vendorId, periodStart, periodEnd])
  @@index([businessId, periodStart])
  @@map("vendor_target")
}
