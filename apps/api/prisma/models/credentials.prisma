// Credentials that prove possession: a second factor, recovery codes, and the
// short-lived tokens used for verification and password reset.
//
// Every secret in this file is stored in a form that is useless on its own:
// hashed (recovery codes, verification tokens) or encrypted (the TOTP secret).
// A stolen database dump must not be enough to impersonate anybody.

/// TOTP enrolment for one user (requirement A.V).
model MfaSecret {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  /// Encrypted with the application key. One row per user, hence the unique index.
  secretEncrypted String @map("secret_encrypted") @db.Text

  /// Set only once the user proves possession by entering a valid code, so a
  /// half-finished enrolment can never lock anybody out.
  confirmedAt DateTime? @map("confirmed_at")
  lastUsedAt  DateTime? @map("last_used_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secret")
}

/// Single-use MFA recovery codes, hashed exactly like passwords.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Partial index on the unused ones: the only lookups are "find a valid unused code
  // for this user", and used rows are dead weight.
  @@index([userId, usedAt])
  @@map("recovery_code")
}

/// Short-lived, single-use tokens for email verification, password reset and MFA reset.
/// Invitations carry their own token on the Invitation row instead, because they exist
/// before an account does.
model VerificationToken {
  id      String              @id @default(cuid())
  userId  String              @map("user_id")
  purpose VerificationPurpose

  /// SHA-256 of the token. The raw value only ever exists in the email that carries it.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_token")
}
