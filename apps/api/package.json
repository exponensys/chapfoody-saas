{
  "name": "@chapfoody/api",
  "version": "0.1.0",
  "private": true,
  "description": "Chapfoody API and background worker (NestJS 12, Prisma, BullMQ)",
  "main": "dist/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n ts,api -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env.local --enable-source-maps dist/main.js\"",
    "dev:worker": "concurrently -k -n ts,worker -c blue,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env.local --enable-source-maps dist/worker.js\"",
    "start": "node --env-file-if-exists=.env.local dist/main.js",
    "start:worker": "node --env-file-if-exists=.env.local dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pretest:coverage": "prisma generate",
    "test:integration": "jest --testPathPatterns=integration-spec",
    "openapi:export": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env.local dist/scripts/export-openapi.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:reset": "node scripts/db-reset.mjs",
    "db:erd": "node scripts/generate-erd.mjs",
    "db:erd:check": "node scripts/generate-erd.mjs --check",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest": "prisma generate",
    "clean": "rm -rf dist coverage .turbo *.tsbuildinfo src/generated"
  },
  "dependencies": {
    "@chapfoody/types": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "nestjs-pino": "5.2.1",
    "otplib": "^12.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@chapfoody/config": "workspace:*",
    "@nestjs/testing": "11.2.6",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.8",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.14",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
