{
  "name": "@chapfoody/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chapfoody API and background worker — NestJS from M1, health-check placeholder in M0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@chapfoody/types": "workspace:*"
  },
  "devDependencies": {
    "@chapfoody/config": "workspace:*",
    "@types/node": "25.9.8",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
