# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build outputs ───────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
coverage/
*.tsbuildinfo

# ─── Environment (never commit secrets; .env.example is committed) ───────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Editors and OS ──────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ─── Generated files (recreated by tooling, never committed) ─────────────────
# Prisma 7 generates the client as TypeScript into the project. It is rebuilt by
# every `prisma generate`, which runs in pre-build/pre-test hooks, so committing it
# would only add thousands of machine-authored lines to every review.
apps/api/src/generated/

# Next.js rewrites next-env.d.ts on every `next dev` and `next build`, and the
# content flaps between `./.next/dev/types/...` (dev) and `./.next/types/...`
# (build). Both variants reference the git-ignored `.next/` directory, so
# committing it only guarantees a permanently dirty working tree.
# It is regenerated explicitly by `next typegen` — which the app's `typecheck`
# script runs before `tsc` — and implicitly by every dev and build run.
apps/next/next-env.d.ts

# ─── Misc ────────────────────────────────────────────────────────────────────
.cache/
tmp/
