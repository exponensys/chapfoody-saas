{
  "name": "chapfoody-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Chapfoody SaaS — monorepo: NestJS API, Next.js platform (marketing, dashboards, storefront), Prisma/PostgreSQL on Neon",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@chapfoody/config": "workspace:*",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "5.9.3"
  }
}
