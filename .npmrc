# ─── Node / tooling ──────────────────────────────────────────────────────────
# Recommended runtime is Node 24 LTS. Local Node 25.x also satisfies the engines
# range declared in package.json (>=24.0.0), which is why CI and local dev can
# differ without breaking the test runner (Vitest 4 requires >= 24).
engine-strict=true

# No further pnpm settings are declared on purpose. Their defaults are already
# the behaviour we want (pnpm ≥ 8 auto-installs peers and tolerates peer
# mismatches; pnpm ≥ 10 does not hoist and resolves the highest matching version).
# Declaring them anyway only makes `npm` warn about unknown keys in this file.
